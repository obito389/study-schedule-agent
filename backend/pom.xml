<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.studyplanner</groupId>
    <artifactId>studyplanner-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>studyplanner-backend</name>
    <description>学习日程 Agent 后端</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.6</springdoc.version>
    </properties>

    <dependencies>
        <!-- Spring MVC REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 数据访问 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring AI（模型封装）：暂不引入，见 pom 尾部注释说明 -->
        <!-- Swagger 联调接口说明 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- MySQL 8 正式数据 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway 数据库迁移 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 测试：H2 仅用于快速单元测试 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 / Mockito / Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        关于 Spring AI（agent.md 技术栈提及 "Spring AI 1.1.x 封装模型调用"）：
        agent.md 中写的坐标 org.springframework.ai:spring-ai-spring-boot-starter 在 1.1.x
        版本中已不存在——该聚合 starter 被移除，1.1.x 起改为按模型拆分的
        spring-ai-starter-model-{model}，且 1.1.x 的 jar 托管在 Spring Milestones 仓库
        而非 Maven Central。Task 1（跨模块契约）不消费任何模型能力，因此这里暂不引入该
        依赖以免阻塞构建。待 Task 4 实现 Agent 动作生成时，再按已确认的模型服务与正确
        坐标（spring-ai-bom + spring-ai-starter-model-*，必要时增加 Spring Milestones 仓库）
        重新接入。
    -->
</project>
